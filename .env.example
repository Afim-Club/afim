# Copy to .env and fill in. Never commit .env.

# Domain
DOMAIN=afim.club

# Database (MariaDB)
DATABASE_HOST=mariadb
DATABASE_PORT=3306
DATABASE_NAME=afim
DATABASE_USERNAME=afim
DATABASE_PASSWORD=change-me

# Strapi
HOST=0.0.0.0
PORT=1337
APP_KEYS=change-me-1,change-me-2
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me

# Strapi (used when running cms/ on the host)
DATABASE_CLIENT=mysql
ENCRYPTION_KEY=change-me

# Set SEED=true to load sample data on first boot when no profiles exist
SEED=false

# Astro (web/): API base for build-time fetches and for browser-side search
STRAPI_URL=http://localhost:1337
PUBLIC_STRAPI_URL=http://localhost:1337

# Swarm deploy (infra/stack.yml)
REGISTRY=registry.example.com/afim
TAG=latest
ACME_EMAIL=admin@example.com
CORS_ORIGINS=https://afim.club

# Partner sign-up anti-spam (all optional)
SUBMIT_RATE_MAX=5
TURNSTILE_SECRET=
PUBLIC_TURNSTILE_SITE_KEY=
