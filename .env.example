# Copy to .env and fill in. Never commit .env.

# Domain
DOMAIN=afim.club

# Database (MariaDB)
DATABASE_HOST=mariadb
DATABASE_PORT=3306
DATABASE_NAME=afim
DATABASE_USERNAME=afim
DATABASE_PASSWORD=change-me

# Strapi
HOST=0.0.0.0
PORT=1337
APP_KEYS=change-me-1,change-me-2
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me

# Strapi (used when running cms/ on the host)
DATABASE_CLIENT=mysql
ENCRYPTION_KEY=change-me

# Set SEED=true to load sample data on first boot when no profiles exist
SEED=false

# Astro (web/): API base for build-time fetches and for browser-side search
STRAPI_URL=http://localhost:1337
PUBLIC_STRAPI_URL=http://localhost:1337
# Public site address for canonical links, Open Graph and the sitemap (default https://afim.club)
SITE_URL=https://afim.club

# Swarm deploy (infra/stack.yml)
REGISTRY=registry.example.com/afim
TAG=latest
ACME_EMAIL=admin@example.com
CORS_ORIGINS=https://afim.club

# Member login (web/ /entrar and /conta)
# Public site URL: social logins redirect back to WEB_URL/entrar/<provider>
WEB_URL=http://localhost:4321
# Social login, each provider enabled only when both values are set. Register this redirect URI at the provider:
# <PUBLIC_URL of the CMS>/api/connect/<provider>/callback (e.g. https://admin.afim.club/api/connect/google/callback)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_LINKEDIN_CLIENT_ID=
AUTH_LINKEDIN_CLIENT_SECRET=
# Buttons shown on /entrar (web build time), matching the providers enabled above, e.g. google,facebook
PUBLIC_AUTH_PROVIDERS=

# Partner sign-up anti-spam (all optional)
SUBMIT_RATE_MAX=5
TURNSTILE_SECRET=
PUBLIC_TURNSTILE_SITE_KEY=

# Local dev through a tunnel (e.g. cloudflared), read by ./dev.sh. Leave empty for plain localhost.
DEV_WEB_HOST=
DEV_PARTNERS_HOST=
DEV_CMS_HOST=
