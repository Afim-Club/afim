# Local development: cp cms/.env.example cms/.env
# Read by Strapi when running on the host (npm run develop).
# Values match the defaults in the root docker-compose.yml. Dev-only secrets: never reuse them.

HOST=0.0.0.0
PORT=1337

APP_KEYS=dev-key-1,dev-key-2
API_TOKEN_SALT=dev-api-token-salt
ADMIN_JWT_SECRET=dev-admin-jwt-secret
JWT_SECRET=dev-jwt-secret
TRANSFER_TOKEN_SALT=dev-transfer-token-salt
ENCRYPTION_KEY=dev-encryption-key
# Field encryption key; empty uses the public development key (production requires a real one)
DATA_ENCRYPTION_KEY=

DATABASE_CLIENT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=afim
DATABASE_USERNAME=afim
DATABASE_PASSWORD=change-me
DATABASE_SSL=false

# Load sample categories/profiles on boot (only when no profiles exist)
SEED=true

# Browser origins allowed to call the API (the web/ dev server)
CORS_ORIGINS=http://localhost:4321

# Strapi MCP server at http://localhost:1337/mcp for AI clients (needs an Admin token)
MCP_ENABLED=false
