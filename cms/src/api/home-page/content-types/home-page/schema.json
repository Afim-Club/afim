{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home page",
    "description": "Marketing home page (afim.club/)."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "heroTitle": {
      "type": "string",
      "required": true
    },
    "heroText": {
      "type": "text"
    },
    "heroNote": {
      "type": "text"
    },
    "searchPlaceholder": {
      "type": "string"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "marketing.steps",
        "marketing.feature-grid",
        "marketing.cta-band",
        "marketing.faq",
        "marketing.directory-showcase"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
