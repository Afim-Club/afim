{
  "kind": "collectionType",
  "collectionName": "plans",
  "info": {
    "singularName": "plan",
    "pluralName": "plans",
    "displayName": "Plan",
    "description": "Plans shown on /planos (see docs/monetization.md). The free row has price 0."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "priceMonthlyBrl": {
      "type": "decimal",
      "default": 0
    },
    "priceYearlyBrl": {
      "type": "decimal",
      "default": 0
    },
    "priceMonthlySats": {
      "type": "integer"
    },
    "features": {
      "type": "json"
    },
    "highlights": {
      "type": "json"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "stripePriceIdMonthly": {
      "type": "string",
      "private": true
    },
    "stripePriceIdYearly": {
      "type": "string",
      "private": true
    }
  }
}
