{
  "collectionName": "components_member_affinity_preferences",
  "info": {
    "displayName": "Affinity preference",
    "description": "An affinity a member declared and which kinds of profiles they want to find for it. For political issues (affinities with a lean) it holds the member's answer in `stance` instead."
  },
  "options": {},
  "attributes": {
    "affinity": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::affinity.affinity"
    },
    "stance": {
      "type": "enumeration",
      "enum": [
        "agrees",
        "disagrees",
        "neutral"
      ]
    },
    "findPeople": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "findCompanies": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "findShops": {
      "type": "boolean",
      "default": true,
      "required": true
    }
  }
}
