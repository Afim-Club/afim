---
/** Surface for grouped content. Renders as `<li>` inside lists with `as="li"`. Other attributes (e.g. `data-*`) pass through. */
interface Props { as?: 'div' | 'li' | 'article'; class?: string; [attr: string]: unknown }
const { as: Tag = 'div', class: className, ...rest } = Astro.props;
---
<Tag {...rest} class:list={['rounded-afim border border-line bg-surface p-4 shadow-xs', className]}><slot /></Tag>
