---
/** Surface for grouped content. Renders as `<li>` inside lists with `as="li"`. */
interface Props { as?: 'div' | 'li' | 'article'; class?: string }
const { as: Tag = 'div', class: className } = Astro.props;
---
<Tag class:list={['rounded-afim border border-line bg-surface p-4 shadow-xs', className]}><slot /></Tag>
