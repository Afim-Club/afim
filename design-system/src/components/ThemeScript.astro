---
/**
 * Put in <head>: applies the theme saved by ThemeToggle before first paint (no flash).
 * Without a saved choice the theme follows the system (prefers-color-scheme).
 */
---
<script is:inline>
  try {
    var t = localStorage.getItem('afim.theme');
    if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
  } catch (e) {}
</script>
