---
/** Button that switches light/dark and remembers the choice (localStorage `afim.theme`). Needs ThemeScript in <head>. */
---
<button type="button" data-theme-toggle class="inline-flex size-8 cursor-pointer items-center justify-center rounded-afim text-muted hover:bg-surface hover:text-fg" aria-label="Alternar tema claro/escuro" title="Alternar tema claro/escuro">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" />
  </svg>
</button>
<script is:inline>
  document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
    if (b.dataset.ready) return;
    b.dataset.ready = '1';
    b.addEventListener('click', function () {
      var root = document.documentElement;
      var dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('afim.theme', root.dataset.theme); } catch (e) {}
    });
  });
</script>
