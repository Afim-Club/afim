# Values for the Dockge stack (infra/dockge/compose.yaml). Paste into the
# stack's ".env" tab in Dockge. Generate each secret with: openssl rand -base64 32

# Public addresses
PUBLIC_URL=https://dash.afim.club
# Sites allowed to call the API from the browser (Cloudflare Workers custom domains)
CORS_ORIGINS=https://afim.club,https://partners.afim.club
# Public site: social logins redirect back to WEB_URL/entrar/<provider>
WEB_URL=https://afim.club
# Host port Strapi listens on (put a reverse proxy or Cloudflare Tunnel in front of it)
CMS_PORT=1337

# Database (MariaDB, data kept in the "mariadb-data" volume)
DATABASE_NAME=afim
DATABASE_USERNAME=afim
DATABASE_PASSWORD=change-me

# Strapi secrets (APP_KEYS is a comma-separated list)
APP_KEYS=change-me-1,change-me-2
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Load sample data on first boot (only when no profiles exist)
SEED=false

# Partner sign-up anti-spam (optional)
SUBMIT_RATE_MAX=5
TURNSTILE_SECRET=

# Social login (optional, each provider enabled only when both values are set)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_LINKEDIN_CLIENT_ID=
AUTH_LINKEDIN_CLIENT_SECRET=

# Image tag on ghcr.io/afim-club/afim-cms: latest (main) or a commit SHA to pin/roll back
CMS_TAG=latest
