---
import Layout from '../layouts/Layout.astro';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const api = import.meta.env.PUBLIC_STRAPI_URL ?? 'http://localhost:1337';
---
<Layout title="Cadastro">
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <h1>Cadastro de parceiro</h1>
  <form id="f">
    <input name="name" placeholder="Nome do negócio" required />
    <select name="profileType" required>
      <option value="company">Empresa</option>
      <option value="shop">Comércio</option>
      <option value="ngo">ONG</option>
    </select>
    <input name="contactEmail" type="email" placeholder="E-mail de contato (não será público)" required />
    <input name="city" placeholder="Cidade" />
    <input name="state" placeholder="UF" maxlength="2" />
    <textarea name="description" rows="4" placeholder="Apresentação"></textarea>
    <input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
    {siteKey && <div class="cf-turnstile" data-sitekey={siteKey}></div>}
    <button>Enviar para revisão</button>
  </form>
  <p id="msg" role="status"></p>
  <script define:vars={{ api }}>
    const form = document.getElementById('f');
    const msg = document.getElementById('msg');
    const button = form.querySelector('button');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true; // no double submits
      msg.textContent = 'Enviando...';
      try {
        const res = await fetch(`${api}/api/profiles/submit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...Object.fromEntries(new FormData(form)), captchaToken: form.querySelector('[name="cf-turnstile-response"]')?.value }),
        });
        msg.textContent = res.status === 429 ? 'Muitas tentativas. Tente novamente mais tarde.' : res.ok ? 'Recebemos seu cadastro! Ele será analisado em breve.' : 'Não foi possível enviar. Confira os campos e a verificação e tente novamente.';
        if (res.ok) form.reset();
      } catch {
        msg.textContent = 'Falha de conexão. Tente novamente em instantes.';
      } finally {
        window.turnstile?.reset(); // Turnstile tokens are single-use
        button.disabled = false;
      }
    });
  </script>
</Layout>
