---
// partners.afim.club moved to afim.club/parceiros. Workers redirects with public/_redirects and the Docker
// image with infra-nginx.conf; this page is only the fallback for anything that serves dist/ as is.
const target = 'https://afim.club/parceiros';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Afim Parceiros</title>
  </head>
  <body>
    <p>O site de parceiros agora fica em <a href={target}>afim.club/parceiros</a>.</p>
  </body>
</html>
