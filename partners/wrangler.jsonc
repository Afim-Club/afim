// Cloudflare Workers deploy of the static partners site (no adapter: every page
// is prerendered, so the Worker only serves the files in dist/).
// Build variables (Workers Builds > Settings > Build): PUBLIC_STRAPI_URL,
// PUBLIC_TURNSTILE_SITE_KEY. See README "Deploy".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afim-partners",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" }
}
