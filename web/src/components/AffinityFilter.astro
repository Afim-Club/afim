---
/**
 * Affinity filter shown above listings. Profile cards carry their public affinities in `data-affinities`
 * and the browser hides the ones that don't match (see ../lib/affinity-filter.ts): signed-in members always
 * see profiles that share their affinities; visitors pick affinities here. The pages stay static.
 */
import Button from '@afim/design-system/components/Button.astro';
import { getProfileAffinities, type Affinity } from '../lib/strapi';

let cache: Promise<Affinity[]> | undefined;
const affinities = await (cache ??= getProfileAffinities());
const POSITION_GROUP = 'Política';
const GROUP_LABELS: Record<string, string> = { '': 'Valores', [POSITION_GROUP]: 'Espectro político' };
const groups = Map.groupBy(affinities, (a) => a.group ?? '');
---
<!-- Hide cards until the filter runs when this browser has a session or a saved choice, to avoid a flash of every profile. -->
<script is:inline>
  try { if (localStorage.getItem('afim.session') || localStorage.getItem('afim.affinityFilter')) document.documentElement.dataset.affinityPending = ''; } catch {}
</script>
<style is:global>html[data-affinity-pending] [data-affinities] { visibility: hidden; }</style>

<div id="affinity-filter" class="mb-4 grid gap-2">
  <p id="af-member" class="m-0 text-sm text-muted" hidden></p>
  {affinities.length ? (
    <details id="af-visitor" class="rounded-afim border border-line bg-surface p-3" hidden>
      <summary class="cursor-pointer font-medium">Filtrar por afinidade <span id="af-n" class="text-sm text-muted"></span></summary>
      <div class="mt-3 grid gap-3">
        <p class="m-0 text-sm text-muted">Mostra os perfis que têm todas as afinidades marcadas (e qualquer um dos espectros marcados).</p>
        {[...groups].map(([group, list]) => (
          <fieldset class="m-0 border-0 p-0">
            <legend class="mb-1 text-sm font-medium">{GROUP_LABELS[group] ?? group}</legend>
            <div class="flex flex-wrap gap-x-4 gap-y-1">
              {list.map((a) => (
                <label class="inline-flex items-center gap-1 text-sm"><input type="checkbox" value={a.slug} data-spectrum={group === POSITION_GROUP ? '' : undefined} class="accent-brand" /> {a.name}</label>
              ))}
            </div>
          </fieldset>
        ))}
        <p class="m-0 flex items-center gap-3">
          <Button id="af-clear" type="button" variant="outline" size="sm">Limpar</Button>
          <a href="/entrar" class="text-sm">Entre para filtrar sempre pelas suas afinidades</a>
        </p>
      </div>
    </details>
  ) : null}
  <p id="af-count" class="m-0 text-sm text-muted" hidden></p>
</div>

<script>
  import { onFilter, pick, start } from '../lib/affinity-filter';

  const $ = (id: string) => document.getElementById(id)!;
  const boxes = [...document.querySelectorAll<HTMLInputElement>('#af-visitor input[type=checkbox]')];
  const count = $('af-count');

  // Hide non-matching cards; lists with data-limit show only their first N matches (e.g. the home page).
  onFilter((test) => {
    const cards = [...document.querySelectorAll<HTMLElement>('[data-affinities]')];
    for (const el of cards) el.hidden = !!test && !test(el.dataset.affinities!.split(' ').filter(Boolean), el.dataset.type!);
    document.querySelectorAll<HTMLElement>('[data-limit]').forEach((list) => {
      let left = Number(list.dataset.limit);
      list.querySelectorAll<HTMLElement>('[data-affinities]').forEach((el) => { if (!el.hidden && left-- <= 0) el.hidden = true; });
    });
    const shown = cards.filter((el) => !el.hidden).length;
    count.hidden = !test || !cards.length;
    count.textContent = shown ? `Mostrando ${shown} de ${cards.length} perfis.` : 'Nenhum perfil aqui tem essas afinidades.';
  });

  const mode = await start();
  delete document.documentElement.dataset.affinityPending;

  if (mode.kind === 'member') {
    const msg = $('af-member');
    msg.hidden = false;
    msg.innerHTML = mode.count
      ? 'Mostrando só perfis que têm todas as suas afinidades (e um dos espectros políticos que você marcou). <a href="/conta">Alterar afinidades</a>'
      : 'Escolha suas afinidades em <a href="/conta">Minha conta</a> para ver só os perfis que as compartilham.';
  } else if (boxes.length) {
    const details = $('af-visitor') as HTMLDetailsElement;
    const n = $('af-n');
    const update = () => {
      const picked = boxes.filter((b) => b.checked).map((b) => ({ slug: b.value, spectrum: 'spectrum' in b.dataset }));
      n.textContent = picked.length ? `(${picked.length})` : '';
      pick(picked);
    };
    boxes.forEach((b) => { b.checked = mode.selected.includes(b.value); b.addEventListener('change', update); });
    $('af-clear').addEventListener('click', () => { boxes.forEach((b) => (b.checked = false)); update(); });
    update();
    details.hidden = false;
  }
</script>
