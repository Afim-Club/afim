---
/** Trail of links for the directory pages; the last item is the current page. */
interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Navegação estrutural" class="text-sm text-muted">
  <ol class="flex flex-wrap gap-1">
    {items.map((item, i) => (
      <li>
        {i > 0 && <span aria-hidden="true">/ </span>}
        {item.href ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>
