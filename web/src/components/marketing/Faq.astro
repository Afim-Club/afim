---
import type { FaqItem } from '../../lib/content';
interface Props { title?: string; items: FaqItem[] }
const { title, items } = Astro.props;
// FAQPage structured data for search engines.
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: items.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.answer } })),
};
---
<div class="mx-auto max-w-3xl space-y-3">
  {title && <h2 class="text-3xl font-extrabold">{title}</h2>}
  {items.map((q) => (
    <details class="rounded-afim border border-line px-5 py-4">
      <summary class="cursor-pointer font-semibold">{q.question}</summary>
      <p class="mb-0 mt-2 text-muted">{q.answer}</p>
    </details>
  ))}
  {items.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</div>
