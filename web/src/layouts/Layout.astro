---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Afim</title>
  </head>
  <body>
    <header>
      <a href="/" class="brand">Afim</a>
      <nav><a href="/busca">Buscar</a></nav>
    </header>
    <main><slot /></main>
    <footer>Afim — diretório open source de pessoas, negócios e comércios com valores em comum.</footer>
  </body>
</html>
<style is:global>
  body { font-family: system-ui, sans-serif; margin: 0 auto; max-width: 56rem; padding: 0 1rem; line-height: 1.5; }
  header { display: flex; justify-content: space-between; padding: 1rem 0; border-bottom: 1px solid #ddd; }
  .brand { font-weight: 700; text-decoration: none; }
  main { padding: 1.5rem 0; }
  footer { padding: 1rem 0; border-top: 1px solid #ddd; color: #666; font-size: .9rem; }
  ul.cards { list-style: none; padding: 0; display: grid; gap: .75rem; }
  ul.cards li { border: 1px solid #ddd; border-radius: .5rem; padding: .75rem 1rem; }
  .tag { font-size: .8rem; background: #eee; border-radius: 1rem; padding: .1rem .6rem; }
</style>
