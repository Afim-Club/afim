---
import '../../../design-system/afim.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Afim</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="brand">Afim</a>
        <nav><a href="/busca">Buscar</a></nav>
      </div>
    </header>
    <main class="container"><slot /></main>
    <footer class="site-footer">
      <div class="container">Afim — diretório open source de pessoas, negócios e comércios com valores em comum.</div>
    </footer>
  </body>
</html>
