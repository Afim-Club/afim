---
import '../styles/global.css';
import Container from '@afim/design-system/components/Container.astro';
import SiteFooter from '@afim/design-system/components/SiteFooter.astro';
import SiteHeader from '@afim/design-system/components/SiteHeader.astro';
import ThemeScript from '@afim/design-system/components/ThemeScript.astro';
import ThemeToggle from '@afim/design-system/components/ThemeToggle.astro';
import { getModuleSeo, getSiteSetting, mediaUrl, type Seo } from '../lib/content';

/**
 * Page shell with three SEO layers: site-wide defaults (site-setting), the module's own defaults
 * (module-seo: title template, description, image) and the page's own `seo` from Strapi.
 * `wide` drops the centered column so marketing sections can run edge to edge.
 */
interface Props {
  title: string;
  description?: string;
  module?: 'home' | 'explorar' | 'ajuda' | 'blog' | 'parceiros' | 'conta';
  seo?: Seo;
  noindex?: boolean;
  wide?: boolean;
}
const { title, description, module = 'explorar', seo, noindex, wide } = Astro.props;
const site = await getSiteSetting();
const mod = await getModuleSeo(module);
const fullTitle = seo?.metaTitle || (mod?.titleTemplate ?? '%s · Afim').replace('%s', title);
const desc = seo?.metaDescription || description || mod?.defaultDescription || site?.defaultDescription;
const image = mediaUrl(seo?.ogImage) ?? mediaUrl(mod?.ogImage) ?? mediaUrl(site?.ogImage);
// The account area is private, so it stays out of search engines.
const robotsNoindex = noindex || seo?.noindex || module === 'conta';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <ThemeScript />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    {desc && <meta name="description" content={desc} />}
    {robotsNoindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site?.siteName ?? 'Afim'} />
    <meta property="og:title" content={fullTitle} />
    {desc && <meta property="og:description" content={desc} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="alternate" type="application/rss+xml" title="Blog do Afim" href="/blog/rss.xml" />
    <slot name="head" />
  </head>
  <body>
    <!-- Beta corner ribbon: only on wide screens, where the corner is empty; the header badge covers the rest. -->
    <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 hidden h-32 w-32 overflow-hidden xl:block">
      <div class="absolute top-6 -right-10 w-44 rotate-45 bg-brand py-1 text-center text-xs font-bold tracking-widest text-on-brand shadow">BETA</div>
    </div>
    <SiteHeader badge="Beta">
      <a href="/explorar">Explorar</a>
      <a href="/planos">Planos</a>
      <a href="/ajuda">Ajuda</a>
      <a href="/conta">Minha conta</a>
      <ThemeToggle />
    </SiteHeader>
    {wide ? <main><slot /></main> : <Container><main class="py-2"><slot /></main></Container>}
    <SiteFooter>
      <div class="flex flex-wrap justify-between gap-6">
        <p class="max-w-sm">{site?.footerText ?? 'Afim — diretório open source de pessoas, negócios e comércios com valores em comum.'}</p>
        <nav aria-label="Rodapé" class="flex flex-wrap gap-4">
          <a href="/explorar">Explorar</a>
          <a href="/explorar/mapa">Mapa</a>
          <a href="/planos">Planos</a>
          <a href="/parceiros">Para negócios</a>
          <a href="/sobre">Sobre</a>
          <a href="/ajuda">Ajuda</a>
          <a href="/blog">Blog</a>
          <a href="/valores">Valores</a>
          <a href="/avise-me">Avise-me</a>
          <a href="/privacidade">Privacidade</a>
          <a href="https://github.com/Afim-Club/afim" rel="noopener">Código no GitHub</a>
        </nav>
      </div>
    </SiteFooter>
  </body>
</html>
