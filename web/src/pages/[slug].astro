---
/** Home module: free pages at the site root (/sobre, /manifesto, /privacidade...), from the page collection. */
import Layout from '../layouts/Layout.astro';
import { getPages, markdown } from '../lib/content';

export async function getStaticPaths() {
  return (await getPages()).map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<Layout title={page.title} module="home" seo={page.seo}>
  <article class="mx-auto max-w-3xl py-6">
    <h1>{page.title}</h1>
    <Fragment set:html={markdown(page.body)} />
  </article>
</Layout>
