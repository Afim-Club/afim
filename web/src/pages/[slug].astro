---
/** Home module: free pages at the site root (/sobre, /manifesto, /privacidade...), from the page collection. */
import Layout from '../layouts/Layout.astro';
import { getPages, markdown } from '../lib/content';

const page = (await getPages()).find((p) => p.slug === Astro.params.slug);
if (!page) return Astro.rewrite('/404');
---
<Layout title={page.title} module="home" seo={page.seo}>
  <article class="mx-auto max-w-3xl py-6">
    <h1>{page.title}</h1>
    <div class="richtext" set:html={markdown(page.body)} />
  </article>
</Layout>
