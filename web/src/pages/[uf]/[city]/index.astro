---
import Layout from '../../../layouts/Layout.astro';
import Badge from '@afim/design-system/components/Badge.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AffinityFilter from '../../../components/AffinityFilter.astro';
import ProfileCard from '../../../components/ProfileCard.astro';
import { categoryCounts, cityUrl, getDirectory, stateUrl, type City, type State } from '../../../lib/places';

export async function getStaticPaths() {
  const { states, categories } = await getDirectory();
  return states.flatMap((state) =>
    state.cities.map((city) => ({
      params: { uf: state.slug, city: city.slug },
      props: { state, city, counts: categoryCounts(city.profiles, categories) },
    })),
  );
}

const { state, city, counts } = Astro.props as { state: State; city: City; counts: ReturnType<typeof categoryCounts> };
---
<Layout title={`Perfis em ${city.name} - ${state.uf}`} description={`Pessoas, negócios e comércios com valores em comum em ${city.name} (${state.uf}).`}>
  <Breadcrumbs items={[{ name: 'Início', href: '/' }, { name: 'Estados', href: '/estados' }, { name: state.name, href: stateUrl(state) }, { name: city.name }]} />
  <h1>{city.name} <span class="text-muted">· {state.uf}</span></h1>
  {counts.length ? (
    <p class="mb-4 flex flex-wrap gap-2">
      {counts.map(({ category, count }) => <Badge href={`${cityUrl(state, city)}/${category.slug}`}>{category.name} ({count})</Badge>)}
    </p>
  ) : null}
  <AffinityFilter />
  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{city.profiles.map((p) => <ProfileCard profile={p} />)}</ul>
</Layout>
