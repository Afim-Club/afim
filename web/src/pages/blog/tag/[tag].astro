---
/** Blog tag: /blog/tag/<slug>, the posts with that tag. Only tags used by a published post get a page. */
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PostList from '../../../components/blog/PostList.astro';
import { getBlogPosts, type BlogTag } from '../../../lib/content';

const posts = (await getBlogPosts()).filter((p) => p.tags.some((t) => t.slug === Astro.params.tag));
const tag: BlogTag | undefined = posts[0]?.tags.find((t) => t.slug === Astro.params.tag);
if (!tag) return Astro.rewrite('/404');
---
<Layout title={`Posts sobre ${tag.name}`} module="blog">
  <section class="py-6">
    <Breadcrumbs items={[{ name: 'Blog', href: '/blog' }, { name: tag.name }]} />
    <h1>{tag.name}</h1>
  </section>
  <PostList posts={posts} />
</Layout>
