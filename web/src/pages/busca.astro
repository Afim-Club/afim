---
import Button from '@afim/design-system/components/Button.astro';
import Card from '@afim/design-system/components/Card.astro';
import Input from '@afim/design-system/components/Input.astro';
import Layout from '../layouts/Layout.astro';
const api = import.meta.env.PUBLIC_STRAPI_URL ?? 'http://localhost:1337';
---
<Layout title="Buscar">
  <h1>Buscar</h1>
  <form id="f" class="flex flex-col gap-3 sm:flex-row">
    <Input name="q" placeholder="Nome ou descrição" aria-label="Nome ou descrição" />
    <Input name="city" placeholder="Cidade" aria-label="Cidade" />
    <Button>Buscar</Button>
  </form>
  <!-- Template for results built by the script below, so they use the design system Card. -->
  <template id="tpl"><Card as="li"><a class="font-semibold"></a> <span class="text-sm text-muted"></span></Card></template>
  <ul id="results" class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></ul>
  <script define:vars={{ api }}>
    const form = document.getElementById('f');
    const out = document.getElementById('results');
    const tpl = document.getElementById('tpl');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const { q, city } = Object.fromEntries(new FormData(form));
      const p = new URLSearchParams({ 'populate[location]': 'true' });
      if (q) {
        p.set('filters[$or][0][name][$containsi]', q);
        p.set('filters[$or][1][description][$containsi]', q);
      }
      if (city) p.set('filters[location][city][$containsi]', city);
      const res = await fetch(`${api}/api/profiles?${p}`);
      const { data } = await res.json();
      out.replaceChildren(...data.map((x) => {
        const li = tpl.content.firstElementChild.cloneNode(true);
        const a = li.querySelector('a');
        a.href = `/perfis/${x.slug}`;
        a.textContent = x.name;
        li.querySelector('span').textContent = [x.location?.city, x.location?.state].filter(Boolean).join(' / ');
        return li;
      }));
      if (!data.length) out.textContent = 'Nada encontrado.';
    });
  </script>
</Layout>
