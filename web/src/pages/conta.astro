---
import Alert from '@afim/design-system/components/Alert.astro';
import Button from '@afim/design-system/components/Button.astro';
import Card from '@afim/design-system/components/Card.astro';
import FormField from '@afim/design-system/components/FormField.astro';
import Input from '@afim/design-system/components/Input.astro';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Minha conta">
  <div id="root" class="grid gap-6 pt-8" hidden>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="mb-1">Minha conta</h1>
        <p id="email" class="text-sm text-muted"></p>
      </div>
      <Button id="logout" variant="outline" size="sm" type="button">Sair</Button>
    </div>

    <form id="f" class="grid gap-6">
      <Card class="grid gap-4">
        <h2 class="m-0 text-lg">Seus dados</h2>
        <FormField label="Como quer ser chamada(o)"><Input name="displayName" maxlength="120" autocomplete="nickname" /></FormField>
        <div class="grid gap-4 sm:grid-cols-[1fr_6rem]">
          <FormField label="Cidade"><Input name="city" maxlength="120" /></FormField>
          <FormField label="UF"><Input name="state" maxlength="2" /></FormField>
        </div>
      </Card>

      <Card class="grid gap-4">
        <div>
          <h2 class="m-0 text-lg">Suas afinidades</h2>
          <p class="text-sm text-muted">
            Marque suas afinidades para encontrar pessoas, empresas e comércios que as compartilham. Afinidades podem revelar convicções e
            por isso são dados pessoais sensíveis (LGPD): ficam só na sua conta, nunca aparecem para outras pessoas,
            e você pode alterar ou apagar quando quiser.
          </p>
        </div>
        <ul id="affinities" class="grid gap-2 sm:grid-cols-2"></ul>
        <p id="noAffinities" class="text-sm text-muted" hidden>Ainda não há afinidades cadastradas. Elas são criadas no painel do CMS (Content Manager → Affinity).</p>
      </Card>

      <div id="politics" hidden><Card class="grid gap-4">
        <div>
          <h2 class="m-0 text-lg">Posição política</h2>
          <p class="text-sm text-muted">
            Diga se concorda, discorda ou é indiferente a cada pauta. Sua posição é calculada a partir das respostas
            (é preciso responder pelo menos 5). Deixe sem resposta o que preferir não informar.
          </p>
        </div>
        <div class="rounded-afim border border-line p-3">
          <p class="m-0 font-medium">Sua posição: <span id="position">ainda não calculada</span></p>
          <p id="positionDesc" class="mt-1 text-xs text-muted" hidden></p>
        </div>
        <div>
          <p class="m-0 text-sm font-medium">Marque os espectros em que quer encontrar pessoas, empresas e comércios</p>
          <ul id="spectrums" class="mt-2 grid gap-2 sm:grid-cols-2"></ul>
        </div>
        <p id="answered" class="m-0 text-sm text-muted"></p>
        <ul id="pautas" class="grid gap-2 sm:grid-cols-2"></ul>
      </Card></div>

      <label class="flex items-start gap-2 text-sm">
        <input type="checkbox" name="consent" class="mt-1 accent-brand" />
        <span>
          Autorizo o Afim a guardar as afinidades e as respostas sobre pautas que marquei, apenas para me mostrar
          pessoas, empresas e comércios com afinidades em comum. Posso retirar este consentimento a qualquer momento
          desmarcando esta opção.
        </span>
      </label>
      <p id="consentInfo" class="-mt-4 text-xs text-muted"></p>

      <div><Button>Salvar</Button></div>
    </form>
    <Alert id="msg" role="status" />

    <section class="grid gap-3">
      <h2 class="m-0 text-lg">Encontrados para você</h2>
      <ul id="matches" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></ul>
    </section>

    <Card class="grid gap-2">
      <h2 class="m-0 text-lg">Seus perfis no Afim</h2>
      <p class="text-sm text-muted">Cadastre seu perfil profissional e as empresas, comércios e ONGs que você representa. Eles passam por revisão antes de aparecer no Afim.</p>
      <div><Button href="/conta/perfis" variant="outline">Gerenciar meus perfis</Button></div>
    </Card>

    <Card class="grid gap-3">
      <div>
        <h2 class="m-0 text-lg">Convide pessoas</h2>
        <p class="text-sm text-muted">Envie seu link de convite. Você vê só quantas pessoas entraram por ele, nunca quem.</p>
      </div>
      <Input id="inviteLink" readonly aria-label="Seu link de convite" />
      <div class="flex flex-wrap items-center gap-2">
        <Button id="copyInvite" type="button" variant="outline" size="sm">Copiar link</Button>
        <Button id="whatsInvite" href="https://wa.me/" variant="outline" size="sm" target="_blank" rel="noopener">Enviar pelo WhatsApp</Button>
        <span id="inviteCount" class="text-sm text-muted"></span>
      </div>
    </Card>

    <Card class="grid gap-2">
      <h2 class="m-0 text-lg">Excluir conta</h2>
      <p class="text-sm text-muted">Apaga seu login, seus dados, suas afinidades e os perfis que você cadastrou. Não pode ser desfeito.</p>
      <div><Button id="delete" variant="outline" type="button" class="text-danger">Excluir minha conta</Button></div>
    </Card>
  </div>

  <template id="checkRow">
    <li class="rounded-afim border border-line px-3 py-2">
      <label class="flex items-center gap-2 font-medium"><input type="checkbox" data-role="has" class="accent-brand" /> <span></span></label>
    </li>
  </template>
  <template id="pautaRow">
    <li class="flex items-center justify-between gap-2 rounded-afim border border-line px-3 py-2 text-sm">
      <span></span>
      <select data-role="stance" class="rounded-afim border border-line bg-page px-2 py-1 text-sm">
        <option value="">Sem resposta</option>
        <option value="agrees">Concordo</option>
        <option value="disagrees">Discordo</option>
        <option value="neutral">Indiferente</option>
      </select>
    </li>
  </template>
  <template id="matchCard"><Card as="li"><a class="font-semibold"></a> <span class="block text-sm text-muted"></span></Card></template>

  <script>
    import * as auth from '../lib/auth';
    import { TYPE_LABELS } from '../lib/strapi';

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const form = $<HTMLFormElement>('f');
    const msg = $('msg');
    const list = $('affinities');
    const pautas = $('pautas');
    const show = (tone: string, text: string) => { msg.dataset.tone = tone; msg.textContent = text; };
    // A checked row finds every kind of profile (people, companies/NGOs and shops).
    const ALL = { findPeople: true, findCompanies: true, findShops: true };
    const POSITION_GROUP = 'Política'; // the member's own position is derived from the answers (cms/src/api/member/political.ts)
    const clone = (id: string) => ($(id) as HTMLTemplateElement).content.firstElementChild!.cloneNode(true) as HTMLElement;
    const checkRow = (a: any, label: string, checked: boolean) => {
      const li = clone('checkRow');
      li.dataset.id = a.documentId;
      li.querySelector('span')!.textContent = label;
      li.querySelector<HTMLInputElement>('[data-role=has]')!.checked = checked;
      return li;
    };
    const checkedIds = (ul: HTMLElement) =>
      [...ul.querySelectorAll<HTMLElement>('li[data-id]')]
        .filter((li) => li.querySelector<HTMLInputElement>('[data-role=has]')!.checked)
        .map((li) => ({ affinity: li.dataset.id, ...ALL }));
    const countAnswers = () => {
      const n = [...pautas.querySelectorAll('select')].filter((s) => s.value).length;
      $('answered').textContent = `${n} pauta(s) respondida(s).`;
    };
    pautas.addEventListener('change', countAnswers);
    // Matches use the saved preferences, so remind the member to save after any change.
    form.addEventListener('change', () => show('warning', 'Você tem alterações não salvas. Clique em Salvar para atualizar "Encontrados para você".'));

    function renderMember(member: any, affinities: any[]) {
      for (const k of ['displayName', 'city', 'state']) (form.elements.namedItem(k) as HTMLInputElement).value = member[k] ?? '';
      (form.elements.namedItem('consent') as HTMLInputElement).checked = !!member.affinityConsentAt;
      $('consentInfo').textContent = member.affinityConsentAt
        ? `Consentimento dado em ${new Date(member.affinityConsentAt).toLocaleString('pt-BR')}.` : '';
      const prefOf = (a: any) => member.affinities.find((p: any) => p.affinity.documentId === a.documentId);

      // Plain affinities: a checkbox and what to find, grouped under a heading when they have a group.
      const rows: HTMLElement[] = [];
      let group: string | null | undefined;
      for (const a of affinities.filter((x) => x.lean === null && x.group !== POSITION_GROUP)) {
        if (a.group && a.group !== group) {
          const h = document.createElement('li');
          h.className = 'mt-2 text-sm font-semibold text-muted sm:col-span-2';
          h.textContent = a.group;
          rows.push(h);
        }
        group = a.group;
        rows.push(checkRow(a, a.name, !!prefOf(a)));
      }
      list.replaceChildren(...rows);
      $('noAffinities').hidden = affinities.length > 0;

      // Political issues: one answer each. The position is calculated by the CMS when saving.
      const issues = affinities.filter((x) => x.lean !== null);
      $('politics').hidden = !issues.length;
      pautas.replaceChildren(...issues.map((a) => {
        const li = clone('pautaRow');
        li.dataset.id = a.documentId;
        li.querySelector('span')!.textContent = a.name;
        li.querySelector('select')!.value = prefOf(a)?.stance ?? '';
        return li;
      }));
      countAnswers();
      const own = member.politicalPosition;
      $('position').textContent = own?.name ?? 'ainda não calculada';
      $('positionDesc').hidden = !own?.description;
      $('positionDesc').textContent = own?.description ?? '';

      // What to find in each political spectrum. On a first visit, suggest the member's own position.
      const firstTime = !member.affinityConsentAt;
      $('spectrums').replaceChildren(...affinities.filter((x) => x.group === POSITION_GROUP).map((a) => {
        const isOwn = own?.documentId === a.documentId;
        return checkRow(a, a.name + (isOwn ? ' (sua posição)' : ''), !!prefOf(a) || (firstTime && isOwn));
      }));
    }

    async function renderMatches() {
      const tpl = ($('matchCard') as HTMLTemplateElement).content.firstElementChild!;
      const matches = await auth.getMatches();
      $('matches').replaceChildren(...matches.map((p: any) => {
        const li = tpl.cloneNode(true) as HTMLElement;
        const a = li.querySelector('a')!;
        a.href = `/perfis/${p.slug}`;
        a.textContent = p.name;
        li.querySelector('span')!.textContent = `${TYPE_LABELS[p.profileType as keyof typeof TYPE_LABELS]} · Em comum: ${p.matchedAffinities.map((x: any) => x.name).join(', ')}`;
        return li;
      }));
      if (!matches.length) $('matches').textContent = 'Nenhum perfil encontrado com as preferências salvas. Marque afinidades ou espectros, escolha o que quer encontrar e clique em Salvar.';
    }

    async function renderInvite() {
      const { code, accepted } = await auth.getInvite();
      const link = `${location.origin}/entrar?convite=${encodeURIComponent(code)}`;
      $<HTMLInputElement>('inviteLink').value = link;
      $<HTMLAnchorElement>('whatsInvite').href = `https://wa.me/?text=${encodeURIComponent(`Vem para o Afim, onde pessoas, empresas e comércios se encontram por afinidades: ${link}`)}`;
      $('inviteCount').textContent = accepted === 1 ? '1 pessoa entrou pelo seu convite.' : `${accepted} pessoas entraram pelo seu convite.`;
    }
    $('copyInvite').addEventListener('click', async () => {
      const input = $<HTMLInputElement>('inviteLink');
      try { await navigator.clipboard.writeText(input.value); } catch { input.select(); document.execCommand('copy'); }
      $('copyInvite').textContent = 'Copiado!';
    });

    if (!(await auth.restoreSession())) location.replace('/entrar');
    else {
      $('root').hidden = false;
      try {
        await auth.acceptPendingInvite();
        const [user, member, affinities] = await Promise.all([auth.getUser(), auth.getMember(), auth.getAffinities()]);
        $('email').textContent = user.email;
        renderMember(member, affinities);
        renderMatches();
        renderInvite();
      } catch {
        show('danger', 'Não foi possível carregar sua conta. Confira se o CMS está atualizado e no ar, e recarregue a página.');
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const chosen = [
        ...checkedIds(list),
        ...checkedIds($('spectrums')),
        ...[...pautas.querySelectorAll<HTMLElement>('li[data-id]')]
          .map((li) => ({ affinity: li.dataset.id, stance: li.querySelector('select')!.value }))
          .filter((p) => p.stance),
      ];
      const consent = fd.get('consent') === 'on';
      if (chosen.length && !consent) return show('warning', 'Para guardar suas afinidades e respostas, marque a autorização.');
      try {
        const saved = await auth.saveMember({
          displayName: fd.get('displayName'), city: fd.get('city'), state: fd.get('state'),
          consent, affinities: consent ? chosen : [],
        });
        renderMember(saved, await auth.getAffinities());
        show('success', consent ? 'Preferências salvas.' : 'Dados salvos. Nenhuma afinidade foi guardada.');
        renderMatches();
      } catch {
        show('danger', 'Não foi possível salvar. Entre novamente e tente outra vez.');
      }
    });

    $('logout').addEventListener('click', async () => { await auth.logout(); location.assign('/'); });

    $('delete').addEventListener('click', async () => {
      if (!confirm('Excluir sua conta e todos os seus dados? Isso não pode ser desfeito.')) return;
      try {
        await auth.deleteAccount();
        location.assign('/');
      } catch {
        show('danger', 'Não foi possível excluir a conta agora. Tente novamente.');
      }
    });
  </script>
</Layout>
