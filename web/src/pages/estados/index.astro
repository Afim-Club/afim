---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '@afim/design-system/components/EmptyState.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CountList from '../../components/CountList.astro';
import { getDirectory, stateUrl } from '../../lib/places';

const { states } = await getDirectory();
---
<Layout title="Estados" description="Perfis do Afim por estado e cidade.">
  <Breadcrumbs items={[{ name: 'Início', href: '/' }, { name: 'Estados' }]} />
  <h1>Estados</h1>
  {states.length
    ? <CountList items={states.map((s) => ({ name: s.name, href: stateUrl(s), count: s.profiles.length }))} />
    : <EmptyState title="Nenhum perfil com estado ainda." />}
</Layout>
