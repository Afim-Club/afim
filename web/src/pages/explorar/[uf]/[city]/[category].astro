---
import Layout from '../../../../layouts/Layout.astro';
import Badge from '@afim/design-system/components/Badge.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import AffinityFilter from '../../../../components/AffinityFilter.astro';
import ProfileCard from '../../../../components/ProfileCard.astro';
import { cityUrl, getDirectory, inCategory, stateUrl } from '../../../../lib/places';

// A page for each category (or parent category) that has profiles in the city.
const { states, categories } = await getDirectory();
const state = states.find((s) => s.slug === Astro.params.uf);
const city = state?.cities.find((c) => c.slug === Astro.params.city);
const category = categories.find((c) => c.slug === Astro.params.category);
const profiles = city && category ? inCategory(city.profiles, category) : [];
if (!state || !city || !category || !profiles.length) return Astro.rewrite('/404');
const base = cityUrl(state, city);
const children = (category.children ?? []).filter((c) => city.profiles.some((p) => p.categories?.some((pc) => pc.slug === c.slug)));
---
<Layout title={`${category.name} em ${city.name} - ${state.uf}`} description={`${category.name} com valores em comum em ${city.name} (${state.uf}).`}>
  <Breadcrumbs items={[
    { name: 'Explorar', href: '/explorar' }, { name: 'Estados', href: '/explorar/estados' }, { name: state.name, href: stateUrl(state) },
    { name: city.name, href: base }, ...(category.parent ? [{ name: category.parent.name, href: `${base}/${category.parent.slug}` }] : []),
    { name: category.name },
  ]} />
  <h1>{category.name} <span class="text-muted">em {city.name} · {state.uf}</span></h1>
  {children.length ? <p class="mb-4 flex flex-wrap gap-2">{children.map((c) => <Badge href={`${base}/${c.slug}`}>{c.name}</Badge>)}</p> : null}
  <AffinityFilter />
  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{profiles.map((p) => <ProfileCard profile={p} />)}</ul>
</Layout>
