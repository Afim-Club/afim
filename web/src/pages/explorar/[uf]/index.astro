---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CountList from '../../../components/CountList.astro';
import AffinityFilter from '../../../components/AffinityFilter.astro';
import ProfileCard from '../../../components/ProfileCard.astro';
import { cityUrl, getDirectory } from '../../../lib/places';

const state = (await getDirectory()).states.find((s) => s.slug === Astro.params.uf);
if (!state) return Astro.rewrite('/404');
// Profiles that gave a state but no city are only listed here.
const noCity = state.profiles.filter((p) => !state.cities.some((c) => c.profiles.includes(p)));
---
<Layout title={`Perfis em ${state.name}`} description={`Pessoas, negócios e comércios com valores em comum em ${state.name} (${state.uf}).`}>
  <Breadcrumbs items={[{ name: 'Explorar', href: '/explorar' }, { name: 'Estados', href: '/explorar/estados' }, { name: state.name }]} />
  <h1>{state.name}</h1>
  {state.cities.length ? (
    <>
      <h2>Cidades</h2>
      <CountList items={state.cities.map((c) => ({ name: c.name, href: cityUrl(state, c), count: c.profiles.length }))} />
    </>
  ) : null}
  {noCity.length ? (
    <>
      <h2>Sem cidade informada</h2>
      <AffinityFilter />
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{noCity.map((p) => <ProfileCard profile={p} />)}</ul>
    </>
  ) : null}
</Layout>
