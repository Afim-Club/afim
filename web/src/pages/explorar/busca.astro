---
import Button from '@afim/design-system/components/Button.astro';
import Card from '@afim/design-system/components/Card.astro';
import Input from '@afim/design-system/components/Input.astro';
import AffinityFilter from '../../components/AffinityFilter.astro';
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Buscar">
  <h1>Buscar</h1>
  <form id="f" class="flex flex-col gap-3 sm:flex-row">
    <Input name="q" placeholder="Nome ou descrição" aria-label="Nome ou descrição" />
    <Input name="city" placeholder="Cidade" aria-label="Cidade" />
    <Button>Buscar</Button>
  </form>
  <div class="mt-4"><AffinityFilter /></div>
  <!-- Template for results built by the script below, so they use the design system Card. -->
  <template id="tpl"><Card as="li"><a class="font-semibold"></a> <span class="text-sm text-muted"></span></Card></template>
  <ul id="results" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></ul>
  <script>
    import { API } from '../../lib/auth';
    import { onFilter, type Test } from '../../lib/affinity-filter';

    type Hit = { name: string; slug: string; profileType: string; affinities?: { slug: string }[]; location?: { city?: string; state?: string } };
    const form = document.getElementById('f') as HTMLFormElement;
    const out = document.getElementById('results')!;
    const tpl = document.getElementById('tpl') as HTMLTemplateElement;
    let hits: Hit[] | null = null;
    let test: Test | null = null;

    // The affinity filter runs here, in the browser: the search URL never carries affinities.
    const render = () => {
      if (!hits) return;
      const shown = hits.filter((x) => !test || test((x.affinities ?? []).map((a) => a.slug), x.profileType));
      out.replaceChildren(...shown.map((x) => {
        const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const a = li.querySelector('a')!;
        a.href = `/explorar/perfis/${x.slug}`;
        a.textContent = x.name;
        li.querySelector('span')!.textContent = [x.location?.city, x.location?.state].filter(Boolean).join(' / ');
        return li;
      }));
      if (!shown.length) out.textContent = 'Nada encontrado.';
    };
    onFilter((t) => { test = t; render(); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const { q, city } = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const p = new URLSearchParams({ 'populate[location]': 'true', 'populate[affinities][fields][0]': 'slug', 'pagination[pageSize]': '100' });
      if (q) {
        p.set('filters[$or][0][name][$containsi]', q);
        p.set('filters[$or][1][description][$containsi]', q);
      }
      if (city) p.set('filters[location][city][$containsi]', city);
      const res = await fetch(`${API}/api/profiles?${p}`);
      hits = (await res.json()).data;
      render();
    });
  </script>
</Layout>
