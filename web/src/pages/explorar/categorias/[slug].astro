---
import Layout from '../../../layouts/Layout.astro';
import Badge from '@afim/design-system/components/Badge.astro';
import EmptyState from '@afim/design-system/components/EmptyState.astro';
import AffinityFilter from '../../../components/AffinityFilter.astro';
import ProfileCard from '../../../components/ProfileCard.astro';
import { getCategories, profilesBySlugs } from '../../../lib/strapi';
import { cityUrl, getDirectory, inCategory } from '../../../lib/places';

export async function getStaticPaths() {
  const all = await getCategories();
  return Promise.all(
    all.map(async (category) => {
      // A category page also lists profiles from its subcategories.
      const slugs = [category.slug, ...(category.children ?? []).map((c) => c.slug)];
      return { params: { slug: category.slug }, props: { category, profiles: await profilesBySlugs(slugs) } };
    }),
  );
}

const { category, profiles } = Astro.props;
// Cities with profiles in this category, linking to the city + category page.
const { states } = await getDirectory();
const places = states.flatMap((s) =>
  s.cities.map((c) => ({ href: `${cityUrl(s, c)}/${category.slug}`, name: `${c.name} / ${s.uf}`, count: inCategory(c.profiles, category).length })),
).filter((p) => p.count);
---
<Layout title={category.name}>
  {category.parent && <p><a href={`/explorar/categorias/${category.parent.slug}`}>← {category.parent.name}</a></p>}
  <h1>{category.name}</h1>
  {category.children?.length ? (
    <p class="flex flex-wrap gap-2">{category.children.map((c) => <Badge href={`/explorar/categorias/${c.slug}`}>{c.name}</Badge>)}</p>
  ) : null}
  {places.length ? (
    <p class="mb-4 flex flex-wrap gap-2"><span class="text-sm text-muted">Onde:</span>{places.map((p) => <Badge href={p.href}>{p.name} ({p.count})</Badge>)}</p>
  ) : null}
  {profiles.length ? <AffinityFilter /> : null}
  {profiles.length ? <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{profiles.map((p) => <ProfileCard profile={p} />)}</ul> : <EmptyState title="Nenhum perfil ainda." />}
</Layout>
