---
/** Home module: the marketing landing page. Its copy and sections come from the Strapi home-page single type. */
import Button from '@afim/design-system/components/Button.astro';
import Container from '@afim/design-system/components/Container.astro';
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/marketing/CtaBand.astro';
import DirectoryShowcase from '../components/marketing/DirectoryShowcase.astro';
import Faq from '../components/marketing/Faq.astro';
import FeatureGrid from '../components/marketing/FeatureGrid.astro';
import Section from '../components/marketing/Section.astro';
import Steps from '../components/marketing/Steps.astro';
import { getHomePage, type HomePage } from '../lib/content';

const FALLBACK: HomePage = {
  heroTitle: 'Encontre quem compartilha seus valores', sections: [{ __component: 'marketing.directory-showcase' }], seo: null,
};
const home = (await getHomePage()) ?? FALLBACK;
const site = Astro.site?.href ?? 'https://afim.club/';
// Organization + WebSite with a search box for search engines.
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Afim', url: site, sameAs: ['https://github.com/Afim-Club/afim'] },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Afim', url: site,
    potentialAction: { '@type': 'SearchAction', target: `${site}explorar/busca?q={q}`, 'query-input': 'required name=q' } },
];
---
<Layout title="Início" module="home" seo={home.seo} description={home.heroText} wide>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <section class="bg-brand-soft py-16 sm:py-24">
    <Container class="max-w-3xl space-y-5">
      <h1 class="m-0 text-4xl font-extrabold leading-tight sm:text-5xl">{home.heroTitle}</h1>
      {home.heroText && <p class="m-0 text-xl text-muted">{home.heroText}</p>}
      {home.heroNote && <p class="m-0 font-semibold text-brand">{home.heroNote}</p>}
      <form action="/explorar/busca" method="get" class="flex flex-wrap gap-2" role="search">
        <label for="q" class="sr-only">Buscar no diretório</label>
        <input id="q" name="q" type="search" placeholder={home.searchPlaceholder ?? 'Busque por nome ou serviço'}
          class="h-12 min-w-0 flex-1 basis-64 rounded-afim border border-line bg-page px-4 text-base text-fg" />
        <Button size="lg">Buscar</Button>
      </form>
      <p class="m-0 text-sm text-muted">Ou navegue <a href="/explorar">por categoria</a>, <a href="/explorar/estados">por estado</a> ou <a href="/explorar/mapa">no mapa</a>.</p>
    </Container>
  </section>
  {home.sections.map((s) => {
    switch (s.__component) {
      case 'marketing.steps': return <Steps title={s.title} items={s.items ?? []} />;
      case 'marketing.feature-grid': return <FeatureGrid {...s} items={s.items ?? []} />;
      case 'marketing.cta-band': return <CtaBand {...s} />;
      case 'marketing.faq': return <Section><Faq title={s.title} items={s.items ?? []} /></Section>;
      case 'marketing.directory-showcase': return <DirectoryShowcase title={s.title} linkLabel={s.linkLabel} />;
    }
  })}
</Layout>
