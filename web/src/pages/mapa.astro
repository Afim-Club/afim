---
import Select from '@afim/design-system/components/Select.astro';
import EmptyState from '@afim/design-system/components/EmptyState.astro';
import Layout from '../layouts/Layout.astro';
import { TYPE_LABELS, getProfiles } from '../lib/strapi';

// Only profiles with coordinates go on the map. Embedded at build time, like every other page.
const points = (await getProfiles())
  .filter((p) => p.location?.lat != null && p.location?.lng != null)
  .map((p) => ({
    name: p.name,
    slug: p.slug,
    type: p.profileType,
    typeLabel: TYPE_LABELS[p.profileType],
    place: [p.location?.city, p.location?.state].filter(Boolean).join(' / '),
    lat: Number(p.location!.lat),
    lng: Number(p.location!.lng),
  }));
---
<Layout title="Mapa">
  <h1>Mapa</h1>
  {points.length ? (
    <>
      <div class="mb-4 max-w-xs">
        <Select id="type" aria-label="Tipo de perfil">
          <option value="">Todos os tipos</option>
          {Object.entries(TYPE_LABELS).map(([value, label]) => <option value={value}>{label}</option>)}
        </Select>
      </div>
      <div id="map" class="h-[70vh] min-h-80 rounded-afim border border-line" data-points={JSON.stringify(points)}></div>
    </>
  ) : (
    <EmptyState title="Nenhum perfil com localização ainda." />
  )}
</Layout>

<script>
  import 'leaflet/dist/leaflet.css';
  import L from 'leaflet';

  type Point = { name: string; slug: string; type: string; typeLabel: string; place: string; lat: number; lng: number };

  const el = document.getElementById('map');
  if (el) {
    const points: Point[] = JSON.parse(el.dataset.points ?? '[]');
    const brand = getComputedStyle(document.documentElement).getPropertyValue('--afim-brand').trim() || '#2f7d5b';

    const map = L.map(el, { scrollWheelZoom: false }).setView([-14.2, -51.9], 4); // Brazil
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    // Popup built with textContent: names come from user submissions.
    const popup = (p: Point) => {
      const div = document.createElement('div');
      const a = document.createElement('a');
      a.href = `/perfis/${p.slug}`;
      a.textContent = p.name;
      a.style.fontWeight = '600';
      const meta = document.createElement('div');
      meta.textContent = [p.typeLabel, p.place].filter(Boolean).join(' · ');
      div.append(a, meta);
      return div;
    };

    const layer = L.featureGroup().addTo(map);
    const show = (type: string) => {
      layer.clearLayers();
      points
        .filter((p) => !type || p.type === type)
        .forEach((p) =>
          L.circleMarker([p.lat, p.lng], { radius: 8, color: brand, fillColor: brand, fillOpacity: 0.8, weight: 2 })
            .bindPopup(popup(p))
            .addTo(layer),
        );
      if (layer.getLayers().length) map.fitBounds(layer.getBounds(), { padding: [40, 40], maxZoom: 13 });
    };

    show('');
    document.getElementById('type')?.addEventListener('change', (e) => show((e.target as HTMLSelectElement).value));
  }
</script>
