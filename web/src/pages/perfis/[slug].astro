---
import Layout from '../../layouts/Layout.astro';
import Badge from '@afim/design-system/components/Badge.astro';
import { TYPE_LABELS, getProfiles } from '../../lib/strapi';

export async function getStaticPaths() {
  return (await getProfiles()).map((profile) => ({ params: { slug: profile.slug }, props: { profile } }));
}

const { profile } = Astro.props;
const place = [profile.location?.city, profile.location?.state].filter(Boolean).join(' / ');
const extra = profile.extra?.[0];
const details = extra ? Object.entries(extra).filter(([k, v]) => !['__component', 'id'].includes(k) && v !== null) : [];
---
<Layout title={profile.name}>
  <div class="space-y-3 pt-8">
  <h1>{profile.name} <Badge tone="brand">{TYPE_LABELS[profile.profileType]}</Badge></h1>
  {place && <p class="text-muted">{place}</p>}
  {profile.description && <p>{profile.description}</p>}
  {profile.categories?.length ? <p class="flex flex-wrap gap-2">{profile.categories.map((c) => <Badge href={`/categorias/${c.slug}`}>{c.name}</Badge>)}</p> : null}
  {details.length ? <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">{details.map(([k, v]) => <><dt class="font-medium text-muted">{k}</dt><dd>{String(v)}</dd></>)}</dl> : null}
  {profile.mediaLinks?.length ? (
    <ul class="flex flex-wrap gap-3">{profile.mediaLinks.map((l) => <li><a href={l.url} rel="noopener nofollow">{l.platform}</a></li>)}</ul>
  ) : null}
  </div>
</Layout>
